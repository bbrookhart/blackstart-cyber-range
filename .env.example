# BLACKSTART environment configuration.
#
# Copy to `.env` and adjust if needed. Every value here has a working default;
# the file exists to document what is configurable, not because anything must be
# set before the range will run.
#
# There are NO SECRETS in BLACKSTART and there is nothing to authenticate to.
# The range holds no credentials, connects to no external service, and must
# never be given real utility credentials or configuration (see SECURITY.md).

# --- Experiment output ------------------------------------------------------
# Root directory for evidence packages. `make demo` and `make experiment` write
# under `${EVIDENCE_ROOT}/local`, which is git-ignored.
EVIDENCE_ROOT=evidence

# Default scenario for `make experiment`.
SCENARIO=SCN-001

# --- Container topology -----------------------------------------------------
# Compose command, if you use a different binary or a remote context.
COMPOSE=docker compose

# Host binding for the enterprise dashboard, the ONLY published surface.
# Keep this on loopback. Binding it to 0.0.0.0 would expose the range to your
# local network and contradicts the architecture (ADR-003, SECURITY.md).
BLACKSTART_DASHBOARD_BIND=127.0.0.1:8080
